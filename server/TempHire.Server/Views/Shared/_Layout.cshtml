@*
    The authorization server's pages (sign-in and consent).  Plain HTML and CSS, styled after the
    Angular app's former login page: the same deep blue backdrop, brand orb and floating card.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TempHire</title>
    <style>
        :root {
            --accent: #1d5380;
            --accent-light: #73a9d8;
            --accent-deep: #0f2f4d;
            --text: #1f2937;
            --muted: #6b7280;
            --border: #cbd5e1;
            --error: #b91c1c;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            color: var(--text);
        }

        .page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            padding: 3rem 1rem;
            background:
                radial-gradient(800px 420px at 10% 0%, rgba(115, 169, 216, 0.5), transparent 70%),
                radial-gradient(700px 420px at 100% 100%, rgba(12, 33, 51, 0.7), transparent 70%),
                linear-gradient(150deg, #2c72b3 0%, var(--accent) 45%, var(--accent-deep) 100%);
        }

        .brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.35rem;
            color: #fff;
            text-align: center;
        }

        .orb {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 4.5rem;
            height: 4.5rem;
            margin-bottom: 0.4rem;
            border-radius: 50%;
            font-family: Verdana, sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            background:
                radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.55) 0, rgba(255, 255, 255, 0) 40%),
                radial-gradient(circle at 50% 55%, #3a86c8 0, var(--accent) 70%, #12385a 100%);
            box-shadow: inset 0 -3px 6px rgba(0, 0, 0, 0.25), 0 2px 4px rgba(15, 47, 77, 0.25), 0 8px 18px rgba(15, 47, 77, 0.22);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
        }

        .brand-name {
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        }

        .tagline { font-size: 0.95rem; color: rgba(255, 255, 255, 0.78); }

        .card {
            width: 24rem;
            max-width: 100%;
            padding: 1.5rem;
            border-radius: 18px;
            background: #fff;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 2px 6px rgba(0, 0, 0, 0.12), 0 24px 60px rgba(0, 0, 0, 0.3);
        }

        .card h1 {
            margin: 0 0 1rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--accent);
        }

        form { display: flex; flex-direction: column; gap: 1rem; }

        .field { display: flex; flex-direction: column; gap: 0.25rem; }

        label { font-size: 0.9rem; }

        input[type=email], input[type=password], input[type=text] {
            width: 100%;
            padding: 0.6rem 0.75rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            font: inherit;
        }

        input:focus { outline: 2px solid var(--accent-light); outline-offset: 0; border-color: var(--accent); }

        .actions { display: flex; justify-content: flex-end; gap: 0.5rem; }

        .button {
            padding: 0.6rem 1.1rem;
            border: 1px solid var(--accent);
            border-radius: 6px;
            font: inherit;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(180deg, #4f8fca, var(--accent));
            cursor: pointer;
        }

        .button.secondary { color: var(--accent); background: #fff; }

        .error {
            margin: 0;
            padding: 0.6rem 0.75rem;
            border-left: 4px solid var(--error);
            border-radius: 4px;
            color: var(--error);
            background: #fef2f2;
        }

        .hint { margin: 0; font-size: 0.8rem; color: var(--muted); }
        .hint ul { margin: 0.25rem 0 0; padding-left: 1.1rem; }
        .hint ul ul { margin: 0.1rem 0 0.35rem; list-style: none; padding-left: 0.6rem; }

        /* A sample user: looks like a link, and signs in with one click. */
        .sample {
            padding: 0;
            border: 0;
            background: none;
            font: inherit;
            font-family: ui-monospace, Consolas, monospace;
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 2px;
            cursor: pointer;
        }

        .consent p { margin: 0 0 0.75rem; line-height: 1.45; }
        .consent ul { margin: 0 0 0.75rem; padding-left: 1.2rem; line-height: 1.45; }
        .host { font-family: ui-monospace, Consolas, monospace; }
    </style>
</head>
<body>
    <main class="page">
        <div class="brand">
            <span class="orb" aria-hidden="true">T</span>
            <span class="brand-name">TempHire</span>
            <span class="tagline">Staffing data, made easy to work with</span>
        </div>

        <div class="card">
            @RenderBody()
        </div>
    </main>
</body>
</html>
