<?xml version="1.0" encoding="utf-8"?>
<!-- The packages folder holds builds of IdeaBlade.Validation until it is published to nuget.org
     (see packages/README.md).  Package source mapping takes IdeaBlade.* from there only, and
     everything else from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="IdeaBlade.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
